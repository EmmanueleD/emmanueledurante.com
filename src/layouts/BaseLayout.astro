---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { languagePath, languages, type Language } from '../data/locales';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: Language;
}

const { title, description, noindex = false, lang = 'en' } = Astro.props;
const ogLocale = { en: 'en_US', it: 'it_IT', es: 'es_ES' }[lang];
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const openGraphImageUrl = new URL('/og-image.jpg', siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preserve the existing typography without delaying the first render. -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Radio+Canada+Big:wght@400;700&family=Radio+Canada:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Radio+Canada+Big:wght@400;700&family=Radio+Canada:wght@400;500&display=swap" />
    </noscript>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F8F4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(languagePath(language), siteUrl)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portrait of Emmanuele Durante" />

    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
