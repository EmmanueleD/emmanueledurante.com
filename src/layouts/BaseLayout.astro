---
import '../styles/global.css';

import { getImage, Font } from 'astro:assets';
import profilePortrait from '../assets/emmanuele-hero-no-earbuds-hires.webp';
import { languagePath, languages, ui, type Language } from '../data/locales';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: Language;
  alternateRoute?: string;
}

const { title, description, noindex = false, lang = 'en', alternateRoute = '' } = Astro.props;
const ogLocale = { en: 'en_US', it: 'it_IT', es: 'es_ES' }[lang];
const portraitAlt = { en: 'Portrait of Emmanuele Durante', it: 'Ritratto di Emmanuele Durante', es: 'Retrato de Emmanuele Durante' }[lang];
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
// Build the social-preview image from the same portrait displayed in the hero.
// A content-hashed URL also makes social platforms fetch new artwork after updates.
const previewImage = await getImage({
  src: profilePortrait,
  width: 1200,
  height: 630,
  format: 'jpeg',
  quality: 85,
  fit: 'cover',
  position: 'top',
});
const openGraphImageUrl = new URL(previewImage.src, siteUrl);
const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', siteUrl).href,
  name: 'Emmanuele Durante',
  url: new URL('/', siteUrl).href,
  jobTitle: 'Frontend & E-commerce Engineer',
  knowsAbout: ['Vue.js', 'React', 'Astro', 'TypeScript', 'Shopify', 'Shopware 6', 'B2B e-commerce'],
  sameAs: ['https://www.linkedin.com/in/e14e/'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- The requested font files are downloaded during the Astro build and served locally. -->
    <Font cssVariable="--local-radio-canada-big" preload />
    <Font cssVariable="--local-radio-canada" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F8F4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && languages.map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(languagePath(language) + alternateRoute, siteUrl)} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/' + alternateRoute, siteUrl)} />}
    <!-- All icon formats share the same source design (public/favicon.svg). -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={portraitAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImageUrl} />

    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(personStructuredData)} />}

  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui[lang].skipToContent}</a>
    <slot />
  </body>
</html>
