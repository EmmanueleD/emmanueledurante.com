---
import HomePage from '../../components/HomePage.astro';

// Only these two localized homepages exist. Other language paths return a static 404.
export function getStaticPaths() {
  return [{ params: { lang: 'it' } }, { params: { lang: 'es' } }];
}

const lang = Astro.params.lang as 'it' | 'es';
---

<HomePage lang={lang} />
