---
import { Image } from 'astro:assets';
import profilePortrait from '../assets/emmanuele-durante.png';
import AccentText from '../components/AccentText.astro';
import ActionLink from '../components/ActionLink.astro';
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ServicesSection from '../components/ServicesSection.astro';
import TextLink from '../components/TextLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
const hasServices = site.services.length > 0;
const hasWork = site.projects.length > 0;
const hasExpertise = site.expertise.technologies.length > 0;
const hasProfile = Boolean(
  site.profile.statement.trim() || site.profile.note.trim(),
);
const hasContact = Boolean(
  site.contact.title.trim() || site.contact.note.trim() || site.contact.email.trim(),
);

const sectionVisibility: Record<string, boolean> = {
  '#work': hasWork,
  '#services': hasServices,
  '#expertise': hasExpertise,
  '#profile': hasProfile,
  '#contact': hasContact,
};

const visibleNavigation = site.navigation.filter(
  (item) => sectionVisibility[item.href] ?? true,
);
const visibleSectionCount = 1 + [
  hasWork,
  hasServices,
  hasExpertise,
  hasProfile,
  hasContact,
].filter(Boolean).length;
---

<BaseLayout title={site.title} description={site.description}>
  <header class="site-header shell">
    <a class="wordmark" href="#top" aria-label={`${site.name}, home`}>
      <span class="wordmark__mark" aria-hidden="true"></span>
      {site.name}
    </a>

    {visibleNavigation.length > 0 && (
      <nav aria-label="Primary navigation">
        <ul class="site-nav">
          {visibleNavigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </header>

  <main id="main-content">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero__heading">
        <Eyebrow>{site.hero.eyebrow}</Eyebrow>
        <h1 id="hero-title"><AccentText segments={site.hero.title} /></h1>
      </div>

      <figure class="hero__portrait">
        <Image
          src={profilePortrait}
          alt="Portrait of Emmanuele Durante"
          width={480}
          height={600}
          widths={[240, 360, 480]}
          sizes="(min-width: 48rem) 15rem, 52vw"
          format="webp"
          quality={85}
        />
      </figure>

      <div class="hero__intro">
        <p>{site.hero.introduction}</p>
        <ActionLink href="#work" variant="accent">Explore my work</ActionLink>
        <a class="hero__secondary-cta" href="#contact">Get in touch</a>
      </div>

      <p class="hero__index" aria-hidden="true">
        01 — {String(visibleSectionCount).padStart(2, '0')}
      </p>
    </section>

    {hasWork && (
      <section class="work shell" id="work" aria-labelledby="work-title">
        <div class="work__heading">
          <Eyebrow>{site.work.eyebrow}</Eyebrow>
          <div>
            <h2 id="work-title">{site.work.title}</h2>
            <p>{site.work.introduction}</p>
          </div>
        </div>
        <ol class="work__grid">
          {site.projects.map((project) => (
            <li class="work__card">
              <div class="work__meta">
                <span>{project.index}</span>
                <span>{project.category}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="work__tags" aria-label="Technologies">
                {project.technologies.map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    )}

    <ServicesSection
      eyebrow={site.servicesSection.eyebrow}
      title={site.servicesSection.title}
      services={site.services}
      accent={site.presentation.accents.serviceItem}
    />

    {hasExpertise && (
      <section
        class="expertise shell"
        id="expertise"
        aria-labelledby="expertise-title"
      >
        <Eyebrow>{site.expertise.eyebrow}</Eyebrow>
        <div class="expertise__content">
          <h2 id="expertise-title">{site.expertise.title}</h2>
          <p>{site.expertise.introduction}</p>
          <ul class="technology-list" aria-label="Prioritized technologies">
            {site.expertise.technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {hasProfile && (
      <section
        class="profile shell"
        id="profile"
        aria-labelledby={site.profile.statement ? 'profile-title' : undefined}
        aria-label={site.profile.statement ? undefined : site.profile.eyebrow}
      >
        <Eyebrow>{site.profile.eyebrow}</Eyebrow>
        <div class="profile__content">
          {site.profile.statement && (
            <h2 id="profile-title">{site.profile.statement}</h2>
          )}
          {site.profile.note && <p>{site.profile.note}</p>}
        </div>
      </section>
    )}

    {hasContact && (
      <section
        class="contact"
        id="contact"
        aria-labelledby={site.contact.title ? 'contact-title' : undefined}
        aria-label={site.contact.title ? undefined : site.contact.eyebrow}
      >
        <div class="contact__inner shell">
          <div class="contact__heading">
            {site.presentation.accents.contactRule && (
              <span class="contact__accent-rule" aria-hidden="true"></span>
            )}
            <Eyebrow>{site.contact.eyebrow}</Eyebrow>
          </div>
          {site.contact.title && <h2 id="contact-title">{site.contact.title}</h2>}
          <div class="contact__details">
            {site.contact.note && <p>{site.contact.note}</p>}
            <ContactForm />
            {site.contact.email && (
              <p class="contact__fallback">
                Prefer email?{' '}
                <TextLink
                  class="contact__email"
                  href={`mailto:${site.contact.email}`}
                >
                  {site.contact.email}
                </TextLink>
              </p>
            )}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer shell">
    <p>© {currentYear} {site.name}</p>
    <TextLink href="#top">Back to top</TextLink>
  </footer>
</BaseLayout>
