---
import { Image } from 'astro:assets';
import profilePortrait from '../assets/emmanuele-hero-no-earbuds-hires.webp';
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
const heroTitle = site.hero.title.map((segment) => segment.text).join('');
---

<BaseLayout title={site.title} description={site.description}>
  <header class="site-header">
    <div class="shell site-header__inner">
      <a class="brand" href="#top" aria-label="Emmanuele Durante, home">Emmanuele Durante<span class="brand__asterisk" aria-hidden="true">✳</span></a>
      <nav aria-label="Main navigation">
        <ul class="site-nav">
          {site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a class="header-contact" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero proof-grid" id="top" aria-labelledby="hero-title">
      <div class="shell hero__inner">
        <div class="hero__copy">
          <div class="hero__label"><span class="line-accent" aria-hidden="true"></span> Frontend & commerce engineer</div>
          <h1 id="hero-title">{heroTitle}</h1>
          <p class="hero__intro">{site.hero.introduction}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#work">Selected work <span aria-hidden="true">↗</span></a>
            <a class="button button--quiet" href="#contact">Contact me</a>
          </div>
        </div>
        <figure class="hero__portrait">
          <div class="proof-photo">
            <Image
              src={profilePortrait}
              alt="Portrait of Emmanuele Durante wearing blue-framed glasses and a navy polo shirt."
              width={1122}
              height={1402}
              widths={[360, 560, 800, 1122]}
              sizes="(min-width: 1100px) 35vw, (min-width: 700px) 42vw, 88vw"
              loading="eager"
              fetchpriority="high"
              format="webp"
              quality={88}
            />
          </div>
          <figcaption><span>Emmanuele Durante</span><span>Forlì, Italy</span></figcaption>
        </figure>
        <div class="hero__folio" aria-hidden="true">01 / 05</div>
      </div>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-head">
          <span class="section-head__label">Selected work / {site.projects.length} projects</span>
          <h2 id="work-title">{site.work.title}</h2>
          <p>{site.work.introduction}</p>
        </div>
        <ol class="work-list">
          {site.projects.map((project) => (
            <li class="work-entry">
              <span class="work-entry__index">{project.index}</span>
              <div class="work-entry__main">
                <p class="work-entry__type">{project.category.replaceAll(' · ', ' / ')}</p>
                <h3>{project.title}</h3>
                <p class="work-entry__description">{project.description}</p>
              </div>
              <ul class="work-entry__tags" aria-label="Technologies">
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="shell services-section__inner">
        <div class="services-section__intro">
          <span class="section-head__label">Capabilities</span>
          <h2 id="services-title">{site.servicesSection.title}</h2>
        </div>
        <ol class="services-list">
          {site.services.map((service) => (
            <li>
              <span class="services-list__index">{service.index}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="profile-section" id="profile" aria-labelledby="profile-title">
      <div class="shell profile-section__inner">
        <div class="profile-section__statement">
          <span class="section-head__label">About the engineer</span>
          <h2 id="profile-title">{site.profile.statement}</h2>
          <p>{site.profile.note}</p>
        </div>
        <div class="profile-section__expertise" id="expertise">
          <h3>{site.expertise.title}</h3>
          <p>{site.expertise.introduction}</p>
          <ul class="expertise-list" aria-label="Tools and technologies">
            {site.expertise.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="contact-section proof-grid" id="contact" aria-labelledby="contact-title">
      <div class="shell contact-section__inner">
        <div class="contact-section__intro">
          <span class="section-head__label">Get in touch</span>
          <h2 id="contact-title">{site.contact.title}</h2>
          <p>{site.contact.note}</p>
          <a class="contact-section__email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </div>
        <div class="contact-sheet">
          <div class="contact-sheet__heading"><span>Contact / inquiry</span><span>{currentYear}</span></div>
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell site-footer__inner">
      <p>© {currentYear} {site.name}</p>
      <p>Frontend & commerce engineer</p>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>
