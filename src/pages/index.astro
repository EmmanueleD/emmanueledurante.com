---
import { Image } from 'astro:assets';
import profilePortrait from '../assets/emmanuele-hero-no-earbuds-hires.webp';
import ContactForm from '../components/ContactForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
const headline = site.hero.title.map((segment) => segment.text).join('');
---

<BaseLayout title={site.title} description={site.description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="Emmanuele Durante, back to top">
      <span class="brand__name">Emmanuele Durante</span>
      <span class="brand__role">Frontend & commerce engineer</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {site.navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="hero__role">Frontend & commerce engineering</p>
        <h1 id="hero-title">{headline}</h1>
        <p class="hero__intro">{site.hero.introduction}</p>
        <div class="hero__actions">
          <a class="action action--primary" href="#work">Explore selected work</a>
          <a class="action action--text" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <figure class="hero__visual">
        <div class="hero__image">
          <Image
            src={profilePortrait}
            alt="Emmanuele Durante, wearing blue-framed glasses and a navy polo shirt, in an office."
            width={1122}
            height={1402}
            widths={[360, 560, 800, 1122]}
            sizes="(min-width: 1024px) 38vw, (min-width: 640px) 60vw, 90vw"
            format="webp"
            quality={88}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>Based in Forlì, Italy. Working across Europe.</figcaption>
      </figure>
    </section>

    <div class="chapter-line shell" aria-hidden="true">
      <span>Selected work</span><span>Scroll to explore</span>
    </div>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="shell work-section__inner">
        <div class="work-section__heading">
          <h2 id="work-title">{site.work.title}</h2>
          <p>{site.work.introduction}</p>
        </div>
        <ol class="work-list">
          {site.projects.map((project) => (
            <li class="work-item">
              <div class="work-item__number">{project.index}</div>
              <div class="work-item__body">
                <p class="work-item__category">{project.category.replaceAll(' · ', ' / ')}</p>
                <h3>{project.title}</h3>
                <p class="work-item__description">{project.description}</p>
              </div>
              <ul class="work-item__stack" aria-label="Technologies">
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="shell services-section__inner">
        <div class="services-section__intro">
          <p class="section-rubric">Capabilities</p>
          <h2 id="services-title">{site.servicesSection.title}</h2>
          <p>Practical engineering across interfaces, commerce platforms, integrations and maintenance.</p>
        </div>
        <ol class="services-list">
          {site.services.map((service) => (
            <li>
              <span class="services-list__number">{service.index}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-section shell" id="profile" aria-labelledby="profile-title">
      <div class="about-section__lead">
        <h2 id="profile-title">{site.profile.statement}</h2>
        <p>{site.profile.note}</p>
      </div>
      <div class="about-section__expertise" id="expertise" aria-labelledby="expertise-title">
        <h3 id="expertise-title">{site.expertise.title}</h3>
        <p>{site.expertise.introduction}</p>
        <ul class="expertise-list">
          {site.expertise.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="shell contact-section__inner">
        <div class="contact-section__intro">
          <h2 id="contact-title">{site.contact.title}</h2>
          <p>{site.contact.note}</p>
          <a href="mailto:hello@emmanueledurante.com" class="contact-section__email">{site.contact.email}</a>
        </div>
        <div class="contact-section__form">
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell site-footer__inner">
      <p>© {currentYear} {site.name}</p>
      <p>Frontend & commerce engineering</p>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>
