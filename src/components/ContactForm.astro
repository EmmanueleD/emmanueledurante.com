---
import { ui, type Language } from '../data/locales';
import { privacyCopy, privacyPath } from '../data/privacy';

interface Props { lang: Language; }
const { lang } = Astro.props;
const formText = ui[lang].contactForm;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<form class="contact-form" data-contact-form data-statuses={JSON.stringify(formText.statuses)}>
  <div class="contact-form__grid">
    <div class="contact-form__field">
      <label for="contact-name">{formText.name}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required />
    </div>

    <div class="contact-form__field">
      <label for="contact-email">{formText.email}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>

    <div class="contact-form__field">
      <label for="contact-company">{formText.company} <span>({formText.optional})</span></label>
      <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="120" />
    </div>

    <div class="contact-form__field">
      <label for="contact-category">{formText.category}</label>
      <select id="contact-category" name="category" required>
        <option value="">{formText.selectCategory}</option>
        <option value="project">{formText.project}</option>
        <option value="job">{formText.job}</option>
        <option value="collaboration">{formText.collaboration}</option>
      </select>
    </div>
  </div>

  <div class="contact-form__field">
    <label for="contact-message">{formText.message}</label>
    <textarea id="contact-message" name="message" rows="7" minlength="10" maxlength="5000" required></textarea>
  </div>

  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-website">{formText.website}</label>
    <input
      id="contact-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div
    class="contact-form__turnstile"
    role="group"
    data-turnstile-sitekey={turnstileSiteKey}
    aria-label={formText.captcha}
  ></div>

  <div class="contact-form__actions">
    <button type="submit">{formText.submit}</button>
    <p class="contact-form__status" data-contact-status role="status" aria-live="polite"></p>
  </div>
  <p class="contact-form__privacy">{privacyCopy[lang].formNotice} <a href={privacyPath(lang)}>{privacyCopy[lang].formLink}</a>.</p>
</form>

<style>
  .contact-form__privacy { max-width: 65ch; font-size: 13px; line-height: 1.5; color: var(--color-ink-2); }
  .contact-form__privacy a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  // Load the captcha only when the contact section is approached or used.
  // Rendering explicitly avoids downloading Cloudflare's challenge on every page visit.
  interface TurnstileApi {
    render: (
      element: HTMLElement,
      options: {
        sitekey: string;
        theme: 'light';
        size: 'flexible';
        'error-callback': (errorCode: string) => void;
      },
    ) => string | undefined;
    getResponse: (widgetId?: string) => string;
    reset: (widgetId?: string) => void;
  }

  type TurnstileWindow = Window & { turnstile?: TurnstileApi };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const messages = JSON.parse(form.dataset.statuses ?? '{}') as Record<string, string>;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const captchaContainer = form.querySelector<HTMLElement>('[data-turnstile-sitekey]');
    const siteKey = captchaContainer?.dataset.turnstileSitekey ?? '';
    let widgetId: string | undefined;
    let captchaPromise: Promise<void> | undefined;
    let startedAt = Date.now();

    const setStatus = (message: string, isError = false) => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = isError ? 'error' : 'success';
    };

    const ensureCaptcha = (): Promise<void> => {
      if (captchaPromise) return captchaPromise;

      captchaPromise = new Promise<void>((resolve, reject) => {
        if (!captchaContainer || !siteKey) {
          reject(new Error('Turnstile site key is not configured'));
          return;
        }

        const renderCaptcha = () => {
          const turnstile = (window as TurnstileWindow).turnstile;
          if (!turnstile) {
            reject(new Error('Turnstile did not initialize'));
            return;
          }

          try {
            widgetId = turnstile.render(captchaContainer, {
              sitekey: siteKey,
              theme: 'light',
              size: 'flexible',
              'error-callback': (errorCode) => {
                console.warn('[ContactForm] Turnstile error code:', errorCode);
                setStatus(messages.verificationFailed, true);
              },
            });
            resolve();
          } catch (error) {
            reject(error);
          }
        };

        if ((window as TurnstileWindow).turnstile) {
          renderCaptcha();
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.onload = renderCaptcha;
        script.onerror = () => reject(new Error('Could not load Turnstile script'));
        document.head.appendChild(script);
      }).catch((error) => {
        captchaPromise = undefined;
        throw error;
      });

      return captchaPromise;
    };

    if (captchaContainer && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          void ensureCaptcha().catch((error) => {
            console.error('[ContactForm] Captcha initialization:', error);
            setStatus(messages.verificationUnavailable, true);
          });
        }
      }, { rootMargin: '500px' });
      observer.observe(captchaContainer);
    } else {
      void ensureCaptcha().catch((error) => {
        console.error('[ContactForm] Captcha initialization:', error);
      });
    }

    form.addEventListener('focusin', () => {
      void ensureCaptcha().catch((error) => {
        console.error('[ContactForm] Captcha initialization:', error);
      });
    }, { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      try {
        await ensureCaptcha();
      } catch (error) {
        console.error('[ContactForm] Captcha unavailable:', error);
        setStatus(messages.verificationUnavailable, true);
        return;
      }

      const turnstile = (window as TurnstileWindow).turnstile;
      const turnstileToken = turnstile?.getResponse(widgetId) ?? '';

      if (!turnstileToken) {
        setStatus(messages.verificationRequired, true);
        return;
      }

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        company: String(data.get('company') ?? '').trim(),
        category: String(data.get('category') ?? ''),
        message: String(data.get('message') ?? '').trim(),
        website: String(data.get('website') ?? ''),
        startedAt,
        turnstileToken,
      };

      if (submitButton) submitButton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      setStatus(messages.sending);

      try {
        const response = await fetch('https://contact.emmanueledurante.com/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          // The backend returns a public, generic error label. Never log the submitted data.
          const errorBody: unknown = await response.json().catch(() => null);
          const serverError =
            errorBody !== null &&
            typeof errorBody === 'object' &&
            'error' in errorBody &&
            typeof errorBody.error === 'string'
              ? errorBody.error
              : '';
          console.warn('[ContactForm] API rejected request:', {
            status: response.status,
            error: serverError,
          });
          throw new Error(`Contact service returned HTTP ${response.status}${serverError ? `: ${serverError}` : ''}`);
        }

        form.reset();
        startedAt = Date.now();
        turnstile?.reset(widgetId);
        setStatus(messages.success);
      } catch (error) {
        console.error('[ContactForm] Message delivery failed:', error);
        const message = error instanceof Error ? error.message : String(error);
        const code = message.match(/HTTP (\d{3})/)?.[1];

        if (code === '400' && message.includes('Invalid form data')) {
          setStatus(messages.invalidFields, true);
        } else if (code === '400' && message.includes('Invalid submission')) {
          setStatus(messages.tooFast, true);
        } else if (code === '400' && message.includes('Verification failed')) {
          setStatus(messages.securityFailed, true);
        } else if (code === '403' || code === '401') {
          setStatus(messages.verificationRejected, true);
        } else if (code === '429') {
          setStatus(messages.tooMany, true);
        } else if (code) {
          setStatus(`${messages.httpError} (HTTP ${code}). ${messages.fallbackEmail}`, true);
        } else {
          setStatus(messages.cannotReach, true);
        }
      } finally {
        form.removeAttribute('aria-busy');
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>
