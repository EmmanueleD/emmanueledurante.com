---
type Variant = 'primary' | 'accent' | 'quiet';

interface Props {
  href: string;
  variant?: Variant;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  class: className,
  ariaLabel,
} = Astro.props;
---

<a
  class:list={['action-link', `action-link--${variant}`, className]}
  href={href}
  aria-label={ariaLabel}
>
  <slot />
</a>
