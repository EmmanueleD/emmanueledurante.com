---
import { Image } from 'astro:assets';
import profilePortrait from '../assets/emmanuele-hero-no-earbuds-hires.webp';
import ContactForm from './ContactForm.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import ClientLogosSection from './ClientLogosSection.astro';
import { getVisibleClientLogos } from '../data/clientLogos';
import { loadPortfolioCms, makeCopyReader, visibleProjects, visibleServices, visibleClients, approvedTestimonials } from '../lib/portfolioCms';
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacyCopy, privacyPath } from '../data/privacy';
import { localizedSite, ui, languages, languagePath, type Language } from '../data/locales';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const site = localizedSite(lang);
const labels = ui[lang];
const cms = await loadPortfolioCms();
const copy = makeCopyReader(cms.copy, lang);
const projects = visibleProjects(cms.projects, lang) ?? site.projects;
const services = visibleServices(cms.services, lang) ?? site.services;
const clients = visibleClients(cms.clients) ?? getVisibleClientLogos();
const testimonials = approvedTestimonials(cms.testimonials);
const expertise = copy('expertise_technologies', site.expertise.technologies.join(', '))
  .split(',').map((tag) => tag.trim()).filter(Boolean);
const pageTitle = copy('seo_title', site.title);
const pageDescription = copy('seo_description', site.description);
const testimonialNavLabels: Record<Language, string> = { en: 'Testimonials', it: 'Dicono di me', es: 'Opiniones' };
const navigation = testimonials.length
  ? [site.navigation[0], { href: '#testimonials', label: testimonialNavLabels[lang] }, ...site.navigation.slice(1)]
  : site.navigation;
const currentYear = new Date().getFullYear();
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang} pageWorks={projects.map((project) => ({ name: project.title, description: project.description }))}>
  <header class="masthead">
    <div class="frame masthead__inner">
      <a class="wordmark" href="#top">
        <span class="wordmark__mark" aria-hidden="true"></span>
        <span class="wordmark__name"><strong>Emmanuele</strong><span>Durante</span></span>
      </a>
      <nav aria-label={labels.mainNavigation}>
        <ul class="masthead__links">
          {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <nav class="language-switcher" aria-label={labels.languageSelector}>
        {languages.map((code) => (
          <a href={languagePath(code)} lang={code} hreflang={code} aria-label={code === 'en' ? 'English' : code === 'it' ? 'Italiano' : 'Español'} aria-current={code === lang ? 'page' : undefined}>{code.toUpperCase()}</a>
        ))}
      </nav>
      <a class="masthead__contact" href="#contact">{labels.headerContact}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="poster" id="top" aria-labelledby="hero-heading">
      <div class="frame poster__grid">
        <div class="poster__content">
          <h1 id="hero-heading"><span>{copy('hero_heading_first', labels.heroHeadingFirst)}</span><span>{copy('hero_heading_second', labels.heroHeadingSecond)}</span></h1>
          <div class="poster__bottom">
            <p>{copy('hero_intro', site.hero.introduction)}</p>
            <div class="poster__actions">
              <a class="action-primary" href="#work">{labels.viewWork}</a>
              <a class="action-secondary" href="#contact">{labels.contactMe}</a>
            </div>
          </div>
        </div>
        <figure class="poster__image">
          <div class="portrait-print">
            <Image
              src={profilePortrait}
              alt={labels.heroAlt}
              width={1122}
              height={1402}
              widths={[320, 480, 640, 680, 800, 960]}
              sizes="(min-width: 1024px) 36vw, (min-width: 700px) 43vw, 92vw"
              format="webp"
              quality={75}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption><span>Emmanuele Durante</span><span>{labels.basedIn}</span></figcaption>
        </figure>
        <p class="poster__folio">{labels.heroFolio}</p>
      </div>
    </section>

    <ClientLogosSection lang={lang} clients={clients} />

    <section class="projects" id="work" aria-labelledby="projects-heading" hidden={projects.length === 0}>
      <div class="frame">
        <div class="projects__header">
          <h2 id="projects-heading">{copy('work_title', labels.selectedWork)}</h2>
          <p>{copy('work_intro', site.work.introduction)}</p>
        </div>
        <ul class="project-index">
          {projects.map((project) => (
            <li class="project-index__item">
              <div class="project-index__lead">
                <p class="project-index__type">{project.category.replaceAll(' · ', ' / ')}</p>
                <h3>{project.title}</h3>
              </div>
              <div class="project-index__details">
                <p>{project.description}</p>
                <ul aria-label={labels.technologiesLabel}>
                  {project.technologies.map((technology) => <li>{technology}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <TestimonialsSection lang={lang} items={testimonials} />

    <section class="capabilities" id="services" aria-labelledby="services-heading" hidden={services.length === 0}>
      <div class="frame capabilities__layout">
        <div class="capabilities__header">
          <h2 id="services-heading">{copy('services_heading', site.servicesSection.title)}</h2>
          <p>{copy('services_subtitle', labels.capabilitySubtitle)}</p>
        </div>
        <ul class="capabilities__list">
          {services.map((service) => (
            <li>
              <div>
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="profile" id="profile" aria-labelledby="profile-heading">
      <div class="frame profile__grid">
        <div class="profile__statement">
          <h2 id="profile-heading">{copy('profile_statement', site.profile.statement)}</h2>
          <p>{copy('profile_note', site.profile.note)}</p>
        </div>
        <div class="profile__tools" id="expertise">
          <h3>{copy('expertise_heading', site.expertise.title)}</h3>
          <p>{copy('expertise_intro', site.expertise.introduction)}</p>
          <ul aria-label={labels.coreTechnologiesLabel}>
            {expertise.map((technology) => <li>{technology}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-heading">
      <div class="frame contact__grid">
        <div class="contact__copy">
          <h2 id="contact-heading">{copy('contact_heading', site.contact.title)}</h2>
          <p>{copy('contact_intro', site.contact.note)}</p>
          <a href={`mailto:${site.contact.email}`} class="contact__email">{site.contact.email}</a>
        </div>
        <div class="contact__form">
          <ContactForm lang={lang} />
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="frame footer__inner">
      <p>© {currentYear} {site.name}</p>
      <p>{labels.footerSpecialty}</p>
      <a href="https://www.linkedin.com/in/e14e/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
      <a href={privacyPath(lang)}>{privacyCopy[lang].linkLabel}</a>
      <a href="#top">{labels.backToTop}</a>
    </div>
  </footer>
</BaseLayout>
