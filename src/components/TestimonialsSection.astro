---
import type { Language } from '../data/locales';
import type { Testimonial } from '../data/testimonials';

interface Props {
  lang: Language;
  items: readonly Testimonial[];
}

const { lang, items } = Astro.props;
const copy: Record<Language, {
  title: string; introduction: string; readFull: string;
  readOriginal: string; viewProfile: string;
}> = {
  en: {
    title: 'What people say.',
    introduction: 'Feedback from people I have worked with.',
    readFull: 'Read full recommendation',
    readOriginal: 'Original in',
    viewProfile: 'LinkedIn',
  },
  it: {
    title: 'Dicono di me.',
    introduction: 'Le parole di chi ha lavorato con me.',
    readFull: 'Leggi tutta la raccomandazione',
    readOriginal: 'Originale in',
    viewProfile: 'LinkedIn',
  },
  es: {
    title: 'Qué dicen de mí.',
    introduction: 'La opinión de quienes han trabajado conmigo.',
    readFull: 'Leer la recomendación completa',
    readOriginal: 'Original en',
    viewProfile: 'LinkedIn',
  },
};
const languageNames: Record<Language, Record<Language, string>> = {
  en: { en: 'English', it: 'Italian', es: 'Spanish' },
  it: { en: 'inglese', it: 'italiano', es: 'spagnolo' },
  es: { en: 'inglés', it: 'italiano', es: 'español' },
};
const labels = copy[lang];
---

{items.length > 0 && (
  <section class="testimonials" id="testimonials" aria-labelledby="testimonials-heading">
    <div class="frame">
      <div class="testimonials__heading">
        <h2 id="testimonials-heading">{labels.title}</h2>
        <p>{labels.introduction}</p>
      </div>
      <ul class="testimonials__rail" aria-label={labels.title}>
        {items.map((item) => (
          <li class="testimonials__item">
            <article class="testimonial">
              <details class="testimonial__details">
                <summary>
                  <span class="testimonial__excerpt" lang={lang}>“{item.text[lang]}”</span>
                  <span class="testimonial__read-more">{labels.readFull}</span>
                </summary>
                <div class="testimonial__expanded">
                  <blockquote lang={lang}><p>“{item.text[lang]}”</p></blockquote>
                  {lang !== item.sourceLanguage && (
                    <details class="testimonial__original">
                      <summary>{labels.readOriginal} {languageNames[lang][item.sourceLanguage]}</summary>
                      <p lang={item.sourceLanguage}>{item.text[item.sourceLanguage]}</p>
                    </details>
                  )}
                </div>
              </details>
              <footer class="testimonial__credit">
                <div>
                  <strong>{item.author}</strong>
                  <span>{item.role}{item.company ? ` · ${item.company}` : ''}</span>
                </div>
                {item.profileUrl && <a href={item.profileUrl} target="_blank" rel="noopener noreferrer">{labels.viewProfile}</a>}
              </footer>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
