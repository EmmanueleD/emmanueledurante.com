---
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const copy: Record<Language, {
  title: string; introduction: string; readFull: string;
  viewProfile: string; previous: string; next: string;
}> = {
  en: {
    title: 'What people say.',
    introduction: 'Feedback from people I have worked with.',
    readFull: 'Read full recommendation',
    viewProfile: 'LinkedIn',
    previous: 'Previous recommendation',
    next: 'Next recommendation',
  },
  it: {
    title: 'Dicono di me.',
    introduction: 'Le parole di chi ha lavorato con me.',
    readFull: 'Leggi tutta la raccomandazione',
    viewProfile: 'LinkedIn',
    previous: 'Raccomandazione precedente',
    next: 'Raccomandazione successiva',
  },
  es: {
    title: 'Qué dicen de mí.',
    introduction: 'La opinión de quienes han trabajado conmigo.',
    readFull: 'Leer la recomendación completa',
    viewProfile: 'LinkedIn',
    previous: 'Recomendación anterior',
    next: 'Recomendación siguiente',
  },
};
const labels = copy[lang];
---

<!-- Runtime-loaded: no data is embedded into a static build.
     The section stays absent until PocketBase returns approved records. -->
<section
  class="testimonials"
  id="testimonials"
  aria-labelledby="testimonials-heading"
  data-testimonials-cms
  data-language={lang}
  data-cms-url="https://cms.emmanueledurante.com"
  hidden
>
  <div class="frame">
    <div class="testimonials__heading">
      <h2 id="testimonials-heading">{labels.title}</h2>
      <p>{labels.introduction}</p>
      <div class="testimonials__controls" aria-label={labels.title}>
        <button type="button" data-rail-step="-1" aria-label={labels.previous}>←</button>
        <button type="button" data-rail-step="1" aria-label={labels.next}>→</button>
      </div>
    </div>
    <ul class="testimonials__rail" aria-label={labels.title} tabindex="0" data-testimonials-rail></ul>
  </div>

  <template data-testimonial-template>
    <li class="testimonials__item">
      <article class="testimonial">
        <details class="testimonial__details">
          <summary>
            <span class="testimonial__excerpt" data-testimonial-excerpt></span>
            <span class="testimonial__read-more">{labels.readFull}</span>
          </summary>
          <div class="testimonial__expanded">
            <blockquote><p data-testimonial-text></p></blockquote>
            <details class="testimonial__original" data-testimonial-original hidden>
              <summary data-testimonial-original-title></summary>
              <p data-testimonial-original-text></p>
            </details>
          </div>
        </details>
        <footer class="testimonial__credit">
          <div>
            <strong data-testimonial-author></strong>
            <span data-testimonial-role></span>
          </div>
          <a data-testimonial-profile target="_blank" rel="noopener noreferrer" hidden>{labels.viewProfile}</a>
        </footer>
      </article>
    </li>
  </template>
</section>

<script>
  import '../scripts/loadTestimonials';
</script>
