---
import type { Language } from '../data/locales';

interface Props { lang: Language; }
const { lang } = Astro.props;
const labels = {
  en: {
    title: 'Clients & collaborations',
    aria: 'Companies and brands I have worked with',
    previous: 'Previous client',
    next: 'Next client',
    pause: 'Pause movement',
    resume: 'Resume movement',
    all: 'View all clients',
    hideAll: 'Clients directory',
  },
  it: {
    title: 'Clienti e collaborazioni',
    aria: 'Aziende e marchi con cui ho lavorato',
    previous: 'Cliente precedente',
    next: 'Cliente successivo',
    pause: 'Metti in pausa',
    resume: 'Riprendi movimento',
    all: 'Vedi tutti i clienti',
    hideAll: 'Elenco completo dei clienti',
  },
  es: {
    title: 'Clientes y colaboraciones',
    aria: 'Empresas y marcas con las que he trabajado',
    previous: 'Cliente anterior',
    next: 'Cliente siguiente',
    pause: 'Pausar movimiento',
    resume: 'Reanudar movimiento',
    all: 'Ver todos los clientes',
    hideAll: 'Lista completa de clientes',
  },
}[lang];
---

<!-- Client assets and ordering are loaded at runtime from PocketBase.
     Section stays hidden until there are public, visible client records. -->
<section
  class="clients"
  id="clients"
  aria-labelledby="clients-heading"
  data-client-marquee
  data-pause-label={labels.pause}
  data-resume-label={labels.resume}
  hidden
>
  <div class="frame clients__heading">
    <h2 id="clients-heading">{labels.title}</h2>
    <div class="clients__controls" data-client-moving hidden>
      <button type="button" data-client-step="-1" aria-label={labels.previous}>←</button>
      <button type="button" data-client-step="1" aria-label={labels.next}>→</button>
    </div>
  </div>
  <div class="clients__marquee" aria-label={labels.aria}>
    <div class="clients__track" data-client-track>
      <ul class="clients__logos" data-client-original></ul>
      <ul class="clients__logos" data-client-duplicate aria-hidden="true" hidden></ul>
    </div>
  </div>
  <div class="frame clients__accessibility">
    <details class="clients__all">
      <summary>{labels.all} (<span data-client-count>0</span>)</summary>
      <ul class="clients__all-list" aria-label={labels.hideAll} data-client-directory></ul>
    </details>
    <button type="button" class="clients__pause" data-client-pause aria-pressed="false" data-client-moving hidden>{labels.pause}</button>
  </div>
</section>

<script>
  import '../scripts/loadClientLogos';
</script>
