---
import type { Language } from '../data/locales';
import type { ClientLogo } from '../data/clientLogos';

interface Props {
  lang: Language;
  clients: readonly ClientLogo[];
  preview?: boolean;
}

const { lang, clients } = Astro.props;
const labels = {
  en: { title: 'Clients & collaborations', aria: 'Companies and brands I have worked with' },
  it: { title: 'Clienti e collaborazioni', aria: 'Aziende e marchi con cui ho lavorato' },
  es: { title: 'Clientes y colaboraciones', aria: 'Empresas y marcas con las que he trabajado' },
}[lang];
const moving = clients.length >= 4;
---

{clients.length > 0 && (
  <section class="clients" id="clients" aria-labelledby="clients-heading">
    <div class="frame clients__heading">
      <h2 id="clients-heading">{labels.title}</h2>
    </div>
    <div class:list={['clients__marquee', { 'clients__marquee--moving': moving }]} aria-label={labels.aria}>
      <div class="clients__track">
        <ul class="clients__logos">
          {clients.map((client) => (
            <li>
              {client.website ? (
                <a href={client.website} target="_blank" rel="noopener noreferrer" aria-label={client.name}>
                  {client.logoSrc
                    ? <img src={client.logoSrc} alt={client.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    : <span class="clients__placeholder">{client.name}</span>}
                </a>
              ) : (
                client.logoSrc
                  ? <img src={client.logoSrc} alt={client.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  : <span class="clients__placeholder">{client.name}</span>
              )}
            </li>
          ))}
        </ul>
        {moving && (
          <ul class="clients__logos" aria-hidden="true">
            {clients.map((client) => (
              <li>
                {client.logoSrc
                  ? <img src={client.logoSrc} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  : <span class="clients__placeholder">{client.name}</span>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
)}
