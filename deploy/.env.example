# Copy this file to deploy/.env. Never commit deploy/.env.
# Site key is public, NOT the Cloudflare secret key.
PUBLIC_TURNSTILE_SITE_KEY=

# Obtain the real network name using:
# sudo docker inspect contact-caddy --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}'
CONTACT_DOCKER_NETWORK=
